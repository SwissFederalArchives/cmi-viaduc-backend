<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="CMI.Access.Harvest.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
      <section name="CMI.Utilities.Bus.Configuration.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
      <section name="CMI.Manager.Harvest.Properties.DbConnectionSetting" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <applicationSettings>
    <CMI.Access.Harvest.Properties.Settings>
      <setting name="ActaProEndpoint" serializeAs="String">
        <value>@@CMI.Access.Harvest.Properties.Settings.ActaProEndpoint@@</value>
      </setting>
      <setting name="ActaProTokenEndpoint" serializeAs="String">
        <value>@@CMI.Access.Harvest.Properties.Settings.ActaProTokenEndpoint@@</value>
      </setting>
      <setting name="ActaProUser" serializeAs="String">
        <value>@@CMI.Access.Harvest.Properties.Settings.ActaProUser@@</value>
      </setting>
      <setting name="ActaProPassword" serializeAs="String">
        <value>@@CMI.Access.Harvest.Properties.Settings.ActaProPassword@@</value>
      </setting>
      <setting name="ActaProTokenPassword" serializeAs="String">
        <value>@@CMI.Access.Harvest.Properties.Settings.ActaProTokenPassword@@</value>
      </setting>
      <setting name="ActaProTokenUser" serializeAs="String">
        <value>@@CMI.Access.Harvest.Properties.Settings.ActaProTokenUser@@</value>
      </setting>
      <setting name="ActaProGrantType" serializeAs="String">
        <value>@@CMI.Access.Harvest.Properties.Settings.ActaProGrantType@@</value>
      </setting>
    </CMI.Access.Harvest.Properties.Settings>
    <CMI.Utilities.Bus.Configuration.Properties.Settings>
      <setting name="RabbitMqUri" serializeAs="String">
        <value>@@CMI.Utilities.Bus.Configuration.Properties.Settings.RabbitMqUri@@</value>
      </setting>
      <setting name="RabbitMqUserName" serializeAs="String">
        <value>@@CMI.Utilities.Bus.Configuration.Properties.Settings.RabbitMqUserName@@</value>
      </setting>
      <setting name="RabbitMqPassword" serializeAs="String">
        <value>@@CMI.Utilities.Bus.Configuration.Properties.Settings.RabbitMqPassword@@</value>
      </setting>
      <!-- Setting can be ommited or be empty. 
      If empty the response address defaults to the RabbitMqUri
      Only required for RequestResponse calls from BV to SSZ zone-->
      <setting name="RabbitMqUriResponseAddress" serializeAs="String">
        <value>@@CMI.Utilities.Bus.Configuration.Properties.Settings.RabbitMqUri@@</value>
      </setting>
      <setting name="PrefetchCountSettings" serializeAs="String">
        <value>{"m.harvest.manager.syncArchiveRecord": 2}</value>
      </setting>
    </CMI.Utilities.Bus.Configuration.Properties.Settings>
  </applicationSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
    </assemblyBinding>
  </runtime>
</configuration>