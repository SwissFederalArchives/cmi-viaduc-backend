<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="CMI.Manager.Onboarding.Properties.DbConnectionSetting" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
      <section name="CMI.Utilities.Bus.Configuration.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
      <section name="CMI.Manager.Onboarding.Properties.OnboardingSetting" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
      <section name="CMI.Engine.MailTemplate.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
    </assemblyBinding>
  </runtime>
  <applicationSettings>
    <CMI.Utilities.Bus.Configuration.Properties.Settings>
      <setting name="RabbitMqUri" serializeAs="String">
        <value>@@CMI.Utilities.Bus.Configuration.Properties.Settings.RabbitMqUri@@</value>
      </setting>
      <setting name="RabbitMqUserName" serializeAs="String">
        <value>@@CMI.Utilities.Bus.Configuration.Properties.Settings.RabbitMqUserName@@</value>
      </setting>
      <setting name="RabbitMqPassword" serializeAs="String">
        <value>@@CMI.Utilities.Bus.Configuration.Properties.Settings.RabbitMqPassword@@</value>
      </setting>
    </CMI.Utilities.Bus.Configuration.Properties.Settings>
    <CMI.Manager.Onboarding.Properties.DbConnectionSetting>
      <setting name="ConnectionString" serializeAs="String">
        <value>@@CMI.SqlServer.DbConnectionSetting.ConnectionString@@</value>
      </setting>
    </CMI.Manager.Onboarding.Properties.DbConnectionSetting>
    <CMI.Manager.Onboarding.Properties.OnboardingSetting>
      <setting name="PostbackBaseUrl" serializeAs="String">
        <value>http://localhost:12972</value>
      </setting>
      <setting name="ConnectorClientId" serializeAs="String">
        <value>@@ConnectorClientId@@</value>
      </setting>
      <setting name="ConnectorClientSecret" serializeAs="String">
        <value>@@ConnectorClientSecret@@</value>
      </setting>
      <setting name="ConnectorTokenExpiration" serializeAs="String">
        <value>30</value>
      </setting>
      <setting name="ConnectorBaseUrl" serializeAs="String">
        <value>@@ConnectorBaseUrl@@</value>
      </setting>
      <setting name="OnboardingCallbackSuccessUrl" serializeAs="String">
        <value>@@OnboardingCallbackSuccess@@</value>
      </setting>
      <setting name="OnboardingCallbackWarnUrl" serializeAs="String">
        <value>@@OnboardingCallbackWarn@@</value>
      </setting>
      <setting name="OnboardingCallbackErrorUrl" serializeAs="String">
        <value>@@OnboardingCallbackError@@</value>
      </setting>
      <setting name="OnboardingCallbackReviewUrl" serializeAs="String">
        <value>@@OnboardingCallbackReview@@</value>
      </setting>
    </CMI.Manager.Onboarding.Properties.OnboardingSetting>
    <CMI.Engine.MailTemplate.Properties.Settings>
      <setting name="PublicClientUrl" serializeAs="String">
        <value>"@@CMI.Engine.MailTemplate.Properties.Settings.PublicClientUrl@@"</value>
      </setting>
      <setting name="ManagementClientUrl" serializeAs="String">
        <value>"@@CMI.Engine.MailTemplate.Properties.Settings.ManagementClientUrl@@"</value>
      </setting>
    </CMI.Engine.MailTemplate.Properties.Settings>
  </applicationSettings>
  <appSettings>
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>