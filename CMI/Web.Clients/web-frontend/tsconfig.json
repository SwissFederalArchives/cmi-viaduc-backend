{
  "compileOnSave": false,
  "compilerOptions": {
    "importHelpers": true,
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "target": "ES2022",
    "types": [
      "file-saver"
    ],
    "typeRoots": [
      "node_modules/@types",
      "node_modules"
    ],
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "strictNullChecks": false,
		"skipLibCheck": true,
		"baseUrl": ".",
		"ignoreDeprecations": "6.0",
    "module": "es2020",
    "useDefineForClassFields": false
  }
}
