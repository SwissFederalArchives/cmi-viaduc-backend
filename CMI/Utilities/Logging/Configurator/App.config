<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="CMI.Utilities.Logging.Configurator.Properties.LogSettings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <applicationSettings>
    <CMI.Utilities.Logging.Configurator.Properties.LogSettings>
      <setting name="LogLevel" serializeAs="String">
        <value>Information</value>
      </setting>
      <setting name="SendMailOnError" serializeAs="String">
        <value />
      </setting>
      <setting name="OutputFolder" serializeAs="String">
        <value>C:\Logs\{exeName}</value>
      </setting>
      <setting name="Einstellung" serializeAs="String">
        <value />
      </setting>
    </CMI.Utilities.Logging.Configurator.Properties.LogSettings>
  </applicationSettings>
  <appSettings>
    <!--Logging specific settings-->
    <add key="serilog:using:File" value="Serilog.Sinks.File" />
    <add key="serilog:write-to:File.retainedFileCountLimit" value="10" />
  </appSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
    </assemblyBinding>
  </runtime>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>