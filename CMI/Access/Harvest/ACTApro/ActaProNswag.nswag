},\r\n          \"crdate\": {\r\n            \"type\": \"string\",\r\n            \"format\": \"date-time\"\r\n          },\r\n          \"description\": {\r\n            \"type\": \"string\"\r\n          },\r\n          \"status\": {\r\n            \"type\": \"string\"\r\n          },\r\n          \"user\": {\r\n            \"type\": \"string\"\r\n          },\r\n          \"processedDocCount\": {\r\n            \"type\": \"integer\",\r\n            \"format\": \"int32\"\r\n          },\r\n          \"totalDocCount\": {\r\n            \"type\": \"integer\",\r\n            \"format\": \"int32\"\r\n          }\r\n        }\r\n      },\r\n      \"Document\": {\r\n        \"required\": [\r\n          \"block\",\r\n          \"object\"\r\n        ],\r\n        \"type\": \"object\",\r\n        \"properties\": {\r\n          \"DocKey\": {\r\n            \"type\": \"string\"\r\n          },\r\n          \"DocTitle\": {\r\n            \"type\": \"string\"\r\n          },\r\n          \"CreatorID\": {\r\n            \"type\": \"string\"\r\n          },\r\n          \"OwnerID\": {\r\n            \"type\": \"string\"\r\n          },\r\n          \"CreationDate\": {\r\n            \"type\": \"string\",\r\n            \"example\": \"31.12.2025 23:59:59:998\"\r\n          },\r\n          \"ChangeDate\": {\r\n            \"type\": \"string\",\r\n            \"example\": \"31.12.2025 23:59:59:999\"\r\n          },\r\n          \"object\": {\r\n            \"type\": \"string\",\r\n            \"default\": \"document\"\r\n          },\r\n          \"block\": {\r\n            \"$ref\": \"#/components/schemas/DocumentBlock\"\r\n          }\r\n        }\r\n      },\r\n      \"DocumentBlock\": {\r\n        \"required\": [\r\n          \"fields\",\r\n          \"type\"\r\n        ],\r\n        \"type\": \"object\",\r\n        \"properties\": {\r\n          \"type\": {\r\n            \"type\": \"string\"\r\n          },\r\n          \"fields\": {\r\n            \"type\": \"array\",\r\n    