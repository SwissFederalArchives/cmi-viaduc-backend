\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/Document\"\r\n                }\r\n              }\r\n            }\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/document/lock-statuses\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Document lock API\"\r\n        ],\r\n        \"summary\": \"Get multiple documents lock statuses\",\r\n        \"operationId\": \"getDocumentsLockStatuses\",\r\n        \"requestBody\": {\r\n          \"content\": {\r\n            \"application/json\": {\r\n              \"schema\": {\r\n                \"type\": \"array\",\r\n                \"description\": \"Document keys\",\r\n                \"items\": {\r\n                  \"type\": \"string\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"required\": true\r\n        },\r\n        \"responses\": {\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/hal+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ErrorResponse\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/hal+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ErrorResponse\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"409\": {\r\n            \"description\": \"Conflict\",\r\n            \"content\": {\r\n              \"application/hal+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ErrorResponse\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"403\": {\r\n            \"description\": \"Forbidden\",\r\n            \"content\": {\r\n              \"application/hal+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ErrorResponse\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"404\": {\r\n            \"description\": \"Not Found\",\r\n            \"content\": {\r\n              \"application/hal+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ErrorResponse\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"type\": \"array\",\r\n                  \"items\": {\r\n                    \"$ref\": \"#/components/schemas/DocumentLockStatusDTO\"\r\n                  }\r\n                }\r\n              }\r\n            }\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/massoperation/{id}/logs\": {\r\n      \"get\": {\r\n        \"tags\": [\r\n          \"Mass operation API\"\r\n        ],\r\n        \"summary\": \"Getting mass operations logs.\",\r\n        \"operationId\": \"getMassOperationLogs\",\r\n        \"parameters\": [\r\n          {\r\n            \"name\": \"id\",\r\n            \"in\": \"path\",\r\n            \"description\": \"Mass operation ID\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"format\": \"uuid\"\r\n            }\r\n          },\r\n          {\r\n            \"name\": \"status\",\r\n            \"in\": \"query\",\r\n            \"description\": \"Status\",\r\n            \"required\": false,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"enum\": [\r\n                \"SUCCESS\",\r\n                \"WARNING\",\r\n                \"ERROR\"\r\n              ]\r\n            },\r\n            \"example\": \"ERROR\"\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/hal+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ErrorResponse\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/hal+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ErrorResponse\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"409\": {\r\n            \"description\": \"Conflict\",\r\n            \"content\": {\r\n              \"application/hal+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ErrorResponse\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"403\": {\r\n            \"description\": \"Forbidden\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ErrorResponse\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"404\": {\r\n            \"description\": \"Not Found\",\r\n            \"content\": {\r\n              \"application/hal+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ErrorResponse\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"type\": \"array\",\r\n                  \"items\": {\r\n                    \"$ref\": \"#/components/schemas/MassOperationLogDTO\"\r\n                  }\r\n                }\r\n              }\r\n            }\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/massoperation/{id}/info\": {\r\n      \"get\": {\r\n        \"tags\": [\r\n          \"Mass operation API\"\r\n        ],\r\n        \"summary\": \"Getting mass operation information.\",\r\n        \"operationId\": \"getMassOperationInfo\",\r\n        \"parameters\": [\r\n          {\r\n            \"name\": \"id\",\r\n            \"in\": \"path\",\r\n            \"description\": \"Mass operation ID\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"format\": \"uuid\"\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/hal+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ErrorResponse\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/hal+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ErrorResponse\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"409\": {\r\n            \"description\": \"Conflict\",\r\n            \"content\": {\r\n              \"application/hal+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ErrorResponse\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"403\": {\r\n            \"description\": \"Forbidden\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ErrorResponse\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"404\": {\r\n            \"description\": \"Not Found\",\r\n            \"content\": {\r\n              \"application/hal+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ErrorResponse\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/MassOperationInfoDTO\"\r\n                }\r\n              }\r\n            }\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/massoperation/import/scripts\": {\r\n      \"get\": {\r\n        \"tags\": [\r\n          \"Mass operation import documents API\"\r\n        ],\r\n        \"summary\": \"Supported formats for import.\",\r\n        \"operationId\": \"getImportScripts\",\r\n        \"responses\": {\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/hal+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ErrorResponse\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/hal+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ErrorResponse\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"409\": {\r\n            \"description\": \"Conflict\",\r\n            \"content\": {\r\n              \"application/hal+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ErrorResponse\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"403\": {\r\n            \"description\": \"Forbidden\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ErrorResponse\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"404\": {\r\n            \"description\": \"Not Found\",\r\n            \"content\": {\r\n              \"application/hal+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ErrorResponse\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/MassOperationScriptInfoDTO\"\r\n                }\r\n              }\r\n            }\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/massoperation/export/scripts\": {\r\n      \"get\": {\r\n        \"tags\": [\r\n          \"Mass operation export documents API\"\r\n        ],\r\n        \"summary\": \"Supported formats for export.\",\r\n        \"operationId\": \"getExportScripts\",\r\n        \"responses\": {\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/hal+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ErrorResponse\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/hal+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ErrorResponse\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"409\": {\r\n            \"description\": \"Conflict\",\r\n            \"content\": {\r\n              \"application/hal+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ErrorResponse\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"403\": {\r\n            \"description\": \"Forbidden\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ErrorResponse\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"404\": {\r\n            \"description\": \"Not Found\",\r\n            \"content\": {\r\n              \"application/hal+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ErrorResponse\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/MassOperationScriptInfoDTO\"\r\n                }\r\n              }\r\n            }\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/massoperation/export/binary\": {\r\n      \"get\": {\r\n        \"tags\": [\r\n          \"Mass operation export documents API\"\r\n        ],\r\n        \"summary\": \"Getting binary result (file).\",\r\n        \"operationId\": \"getExportFile\",\r\n        \"parameters\": [\r\n          {\r\n            \"name\": \"id\",\r\n            \"in\": \"query\",\r\n            \"description\": \"Mass operation ID\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"format\": \"uuid\"\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/hal+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ErrorResponse\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/hal+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ErrorResponse\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"409\": {\r\n            \"description\": \"Conflict\",\r\n            \"content\": {\r\n              \"application/hal+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ErrorResponse\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"403\": {\r\n            \"description\": \"Forbidden\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ErrorResponse\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"404\": {\r\n            \"description\": \"Not found\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ErrorResponse\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"content\": {\r\n              \"application/octet-stream\": {\r\n                \"schema\": {\r\n                  \"type\": \"string\"\r\n                }\r\n              }\r\n            }\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/document/{key}/children\": {\r\n      \"get\": {\r\n        \"tags\": [\r\n          \"Document API\"\r\n        ],\r\n        \"summary\": \"Get document children by key\",\r\n        \"operationId\": \"getDocumentChildren\",\r\n        \"parameters\": [\r\n          {\r\n            \"name\": \"key\",\r\n            \"in\": \"path\",\r\n            \"description\": \"Document key\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\"\r\n            },\r\n            \"example\": \"Best f71e285f-4d59-41c7-bfa1-334e696a13e1\"\r\n          },\r\n          {\r\n            \"name\": \"fields\",\r\n            \"in\": \"query\",\r\n            \"description\": \"Document fields to show\",\r\n            \"required\": false,\r\n            \"schema\": {\r\n              \"type\": \"string\"\r\n            },\r\n            \"example\": \"Bst_Signatur, Laufzeit, Vz_Bestellsignatur\"\r\n          },\r\n          {\r\n            \"name\": \"documentTypes\",\r\n            \"in\": \"query\",\r\n            \"description\": \"Document types to show\",\r\n            \"required\": false,\r\n            \"schema\": {\r\n              \"type\": \"string\"\r\n            },\r\n            \"example\": \"Best, Vz\"\r\n          },\r\n          {\r\n            \"name\": \"language\",\r\n            \"in\": \"query\",\r\n            \"description\": \"Language version to show\",\r\n            \"required\": false,\r\n            \"schema\": {\r\n              \"type\": \"string\"\r\n            },\r\n            \"example\": \"0x409\"\r\n          },\r\n          {\r\n            \"name\": \"page\",\r\n            \"in\": \"query\",\r\n            \"description\": \"Zero-based page index (0..N)\",\r\n            \"required\": false,\r\n            \"schema\": {\r\n              \"minimum\": 0,\r\n              \"type\": \"integer\",\r\n              \"default\": 0\r\n            }\r\n          },\r\n          {\r\n            \"name\": \"size\",\r\n            \"in\": \"query\",\r\n            \"description\"