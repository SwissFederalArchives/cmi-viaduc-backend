   \"in\": \"query\",\r\n            \"description\": \"The size of the page to be returned\",\r\n            \"required\": false,\r\n            \"schema\": {\r\n              \"minimum\": 1,\r\n              \"type\": \"integer\",\r\n              \"default\": 20\r\n            }\r\n          },\r\n          {\r\n            \"name\": \"sort\",\r\n            \"in\": \"query\",\r\n            \"description\": \"Sorting criteria in the format: property,(asc|desc). Default sort order is ascending. Multiple sort criteria are supported.\",\r\n            \"required\": false,\r\n            \"schema\": {\r\n              \"type\": \"array\",\r\n              \"items\": {\r\n                \"type\": \"string\"\r\n              }\r\n            }\r\n          }\r\n        ],\r\n        \"requestBody\": {\r\n          \"content\": {\r\n            \"application/json\": {\r\n              \"schema\": {\r\n                \"$ref\": \"#/components/schemas/DocumentSearchParams\"\r\n              }\r\n            }\r\n          },\r\n          \"required\": true\r\n        },\r\n        \"responses\": {\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/hal+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ErrorResponse\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/hal+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ErrorResponse\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"409\": {\r\n            \"description\": \"Conflict\",\r\n            \"content\": {\r\n              \"application/hal+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ErrorResponse\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"403\": {\r\n            \"description\": \"Forbidden\",\r\n            \"content\": {\r\n              \"application/hal+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ErrorResponse\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"404\": {\r\n            \"description\": \"Not Found\",\r\n            \"content\": {\r\n              \"application/hal+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ErrorResponse\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/SearchResultPage\"\r\n                }\r\n              }\r\n            }\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/document\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Document API\"\r\n        ],\r\n        \"summary\": \"Create document\",\r\n        \"operationId\": \"createDocument\",\r\n        \"parameters\": [\r\n          {\r\n            \"name\": \"parentDocKey\",\r\n            \"in\": \"query\",\r\n            \"description\": \"Parent Document Key\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\"\r\n            },\r\n            \"example\": \"Best f71e285f-4d59-41c7-bfa1-334e696a13e1\"\r\n          },\r\n          {\r\n            \"name\": \"format\",\r\n            \"in\": \"query\",\r\n            \"description\": \"Document format\",\r\n            \"required\": false,\r\n            \"schema\": {\r\n              \"type\": \"string\"\r\n            },\r\n            \"example\": \"json\"\r\n          }\r\n        ],\