<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="CMI.Manager.Vecteur.Properties.VecteurSettings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
    </assemblyBinding>
  </runtime>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <applicationSettings>
    <CMI.Manager.Vecteur.Properties.VecteurSettings>
      <setting name="BaseDirectory" serializeAs="String">
        <value>c:\vecteur</value>
      </setting>
      <setting name="Address" serializeAs="String">
        <value>@@CMI.Manager.Vecteur.Properties.VecteurSettings.Address@@</value>
      </setting>
      <setting name="SftpPort" serializeAs="String">
        <value>11127</value>
      </setting>
      <setting name="ApiKey" serializeAs="String">
        <value>@@CMI.Manager.Vecteur.Properties.VecteurSettings.ApiKey@@</value>
      </setting>
      <setting name="RequestTimeoutInMinute" serializeAs="String">
        <value>5</value>
      </setting>
      <setting name="SftpPassword" serializeAs="String">
        <value>@@CMI.Manager.Vecteur.Properties.VecteurSettings.SftpPassword@@</value>
      </setting>
      <setting name="SftpLicenseKey" serializeAs="String">
        <value>@@CMI.Manager.Vecteur.Properties.VecteurSettings.SftpLicenseKey@@</value>
      </setting>
      <setting name="SftpPrivateCertKey" serializeAs="String">
        <value>@@CMI.Manager.Vecteur.Properties.VecteurSettings.SftpPrivateCertKey@@</value>
      </setting>
      <setting name="SftpPrivateCertPassword" serializeAs="String">
        <value>@@CMI.Manager.Vecteur.Properties.VecteurSettings.SftpPrivateCertPassword@@</value>
      </setting>
    </CMI.Manager.Vecteur.Properties.VecteurSettings>
  </applicationSettings>
</configuration>